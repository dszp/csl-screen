{
  "name": "@dszp/csl-screen",
  "version": "0.1.0",
  "description": "Restricted-party screening against the US Consolidated Screening List: name normalisation, fuzzy matching and reviewable decisions. Zero runtime dependencies; runs in Node and Cloudflare Workers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dszp/csl-screen.git"
  },
  "homepage": "https://github.com/dszp/csl-screen#readme",
  "bugs": {
    "url": "https://github.com/dszp/csl-screen/issues"
  },
  "author": {
    "name": "David Szpunar",
    "url": "https://david.szpunar.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "restricted-party-screening",
    "consolidated-screening-list",
    "export-compliance",
    "cloudflare-workers"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./autotask": {
      "types": "./dist/adapters/autotask.d.ts",
      "import": "./dist/adapters/autotask.js",
      "require": "./dist/adapters/autotask.js",
      "default": "./dist/adapters/autotask.js"
    },
    "./onebill": {
      "types": "./dist/adapters/onebill.d.ts",
      "import": "./dist/adapters/onebill.js",
      "require": "./dist/adapters/onebill.js",
      "default": "./dist/adapters/onebill.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "src",
    "!src/**/*.test.ts",
    "!src/testkit.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json --sourceMap false --declarationMap false",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3"
  },
  "packageManager": "pnpm@11.11.0"
}
